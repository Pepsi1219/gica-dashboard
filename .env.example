# Microsoft Entra ID App Registration
CLIENT_ID=YOUR_APPLICATION_CLIENT_ID
CLIENT_SECRET=YOUR_CLIENT_SECRET
TENANT_ID=YOUR_TENANT_ID
FLASK_SECRET_KEY=change-this-to-a-long-random-secret

# Microsoft account allowed into the "Admin Sign In" door (case-insensitive)
ADMIN_EMAIL=you@yourcompany.com

# Extra password gate before QE / Admin "Sign in with Microsoft" can proceed
QE_DOOR_PASSWORD=!@#$
ADMIN_DOOR_PASSWORD=Special1219

# Local dev: http://localhost:5000/auth/callback
# Production: https://your-app.vercel.app/auth/callback
REDIRECT_URI=http://localhost:5000/auth/callback

# Excel setup
EXCEL_TABLE_NAME=EmployeeTable

# Session backend:
#   Leave blank (or omit) for Vercel — uses signed cookie session
#   Set to "filesystem" for local development
SESSION_TYPE=filesystem

# Shared KV cache (Vercel KV / Upstash Redis) — optional L2 cache layer for
# GICA/Jumper/Trainer Excel reads. App works fine without it (falls back to
# fetching from Microsoft Graph directly). Use whichever pair of names your
# provisioned integration actually generated — only one pair is needed:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
