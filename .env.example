# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from your Supabase project → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=change-this-to-a-long-random-secret

# ── Microsoft Graph API (Jumper / Trainer / CSA / GICA Excel reads + writes) ──
# These are NOT used for user authentication.
# They are a service credential for reading/writing Excel files on OneDrive.
CLIENT_ID=your-azure-app-client-id
CLIENT_SECRET=your-azure-app-client-secret
TENANT_ID=your-azure-tenant-id

# Central OneDrive account's refresh token — used as the service credential
# for ALL Microsoft Graph API calls (Jumper/Trainer/CSA/GICA Excel files).
MANAGER_REFRESH_TOKEN=your-manager-refresh-token

# Excel setup
EXCEL_TABLE_NAME=EmployeeTable

# Shared KV cache (Vercel KV / Upstash Redis) — optional L2 cache layer.
# App works without it (falls back to fetching from Microsoft Graph directly).
KV_REST_API_URL=
KV_REST_API_TOKEN=
